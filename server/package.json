{
  "name": "express-typescript-starter",
  "version": "1.0.0",
  "description": "A professional Express.js backend starter template with TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docker:start": "docker compose up --build",
    "docker:stop": "docker compose down",
    "docker:restart": "docker compose restart"
  },
  "type": "commonjs",
  "keywords": [
    "express",
    "typescript",
    "nodejs",
    "backend",
    "api",
    "starter",
    "template"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "mariadb": "3.5.5",
    "morgan": "^1.10.1",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "nodemon": "^3.1.11",
    "prisma": "7.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  }
}
