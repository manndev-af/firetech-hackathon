# Environment Configuration
NODE_ENV=development
PORT=3000

# CORS Configuration
CORS_ORIGIN=*

# API Configuration
API_PREFIX=/api

# Local MySQL/XAMPP demo: root without password. Adjust for your local database.
# Create the nutrilens database before running migrations.
DATABASE_URL="mysql://root@127.0.0.1:3306/nutrilens"

# Scanner domain: development/test only, no login endpoints.
ENABLE_DEMO_USER=true
DEMO_USER_EMAIL=demo@nutrilens.test
SEED_USER_EMAIL=demo@nutrilens.test
# Public demo credential only; not for production or real accounts.
SEED_USER_PASSWORD="NutriLensDemo2026!"
# Random dummy placeholder, NOT a valid DeepSeek key. Replace in .env for live scans.
DEEPSEEK_API_KEY=sk-demo-c47a5b6e44223d01afeac6c1923860996a89897960733cf2
DEEPSEEK_MODEL=deepseek-flash
# Optional integration tests: isolated migrated database whose name ends in _test.
# TEST_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/nutrilens_test"

# JWT Configuration (for authentication)
# JWT_SECRET=your_jwt_secret_here
# JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
